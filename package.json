{
  "name": "ReactNativeStarter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "installDevDebug": "cd android && ./gradlew app:installDevDebug",
    "installProdDebug": "cd android && ./gradlew app:installProdDebug",
    "installStagingDebug": "cd android && ./gradlew app:installStagingDebug",
    "android_apk_dev": "cd android && ./gradlew clean && ./gradlew assembleDevRelease",
    "android_staging_dev": "cd android && ./gradlew clean && ./gradlew assembleStagingRelease",
    "android_prod_dev": "cd android && ./gradlew clean && ./gradlew assembleProdRelease",
    "android_man": "cd android && ./gradlew installDevDebug",
    "clean:android": "cd android && ./gradlew clean",
    "test": "jest"
  },
  "codegenConfig": {
    "name": "NativeBuildEnv",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.reactnativestarter"
    },
    "ios": {
      "modulesConformingToProtocol": {
        "RCTTurboModule": [
          "NativeBuildInfoModule"
        ]
      }
    }
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@legendapp/list": "^3.3.7",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@react-native/new-app-screen": "0.86.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/elements": "^2.9.36",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@reduxjs/toolkit": "2.11.2",
    "@tanstack/react-query": "5.90.20",
    "@testing-library/react-native": "13.3.3",
    "axios": "1.13.4",
    "i18next": "25.8.2",
    "react": "19.2.3",
    "react-hook-form": "7.84.0",
    "react-i18next": "16.5.4",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-localize": "3.6.1",
    "react-native-pager-view": "8.0.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.26.2",
    "react-native-vector-icons": "10.3.0",
    "react-native-worklets": "^0.11.3",
    "react-redux": "9.2.0",
    "redux-logger": "3.0.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "29.5.13",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.19.0",
    "jest": "29.6.3",
    "metro-react-native-babel-preset": "0.77.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
